VERSION = "1.0.0"


YDOTOOL_ENV = {**os.environ, "YDOTOOL_SOCKET": "/tmp/.ydotool_socket"}
CTRL = 29
V_KEY = 47
PASTE_SETTLE_SECONDS = 0.3
# The shortcut fires while its own modifiers are still held, so Ctrl+V is
# synthesized only once this long has passed since the key press. Everything
# done before pasting counts towards it. Tune with LAYOUT_FIX_SETTLE_MS.
START_TIME = time.monotonic()
DEFAULT_SETTLE_MS = 250
LOCK_PATH = Path(f"/tmp/layout-fix-{os.getuid()}.lock")
COPYQ = "/usr/bin/copyq"
COPYQ_ENV = {
    **os.environ,
    "QT_QPA_PLATFORM": "wayland",
}
COPYQ_SESSION = "layout-fix"
COPYQ_SNAPSHOT_TAB = "layout-fix-snapshot"
COPYQ_ITEM_MIME = "application/x-copyq-item"
COPYQ_SAVE_SCRIPT = (
    'var f=str(clipboard("?")).split("\\n"); var i={}; '
    'var preferred=['
    '"text/plain;charset=utf-8","text/plain","UTF8_STRING","STRING",'
    '"image/png","image/jpeg","image/webp","image/svg+xml",'
    '"text/uri-list","application/x-kde4-urilist"]; '
    'var mime=""; for(var n=0;n<preferred.length;++n) '
    'if(f.indexOf(preferred[n])>=0){mime=preferred[n];break;} '
    'if(!mime) fail(); i[mime]=clipboard(mime); '
    f'tab("{COPYQ_SNAPSHOT_TAB}"); while(size()) remove(0); '
    f'write(0,"{COPYQ_ITEM_MIME}",pack(i));'
)
