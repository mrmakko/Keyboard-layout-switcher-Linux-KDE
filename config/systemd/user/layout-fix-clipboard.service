[Unit]
Description=Private multi-format clipboard helper for layout-fix
Requisite=graphical-session.target
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=wayland
# Disables ClipboardDataGuard::getImageData() in this session and its
# --clipboard-access children, which is the QMimeData::imageData() path that
# segfaults through DataControlOffer::retrieveData (see docs/copyq-image-crash.md). The
# "image/" probe pattern is matched exactly, so per-format limits such as
# image/png are still governed by the trailing default rule.
Environment="COPYQ_CLIPBOARD_MIME_SIZE_LIMIT=image/:0;.*:100M"
ExecStart=/usr/bin/copyq --session layout-fix
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
